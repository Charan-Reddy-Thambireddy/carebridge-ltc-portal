{
  "name": "carebridge-ltc-portal",
  "private": true,
  "description": "Front-end tooling for CareBridge: Sass build and automated accessibility tests.",
  "scripts": {
    "sass:build": "sass src/CareBridge.Api/Styles/site.scss src/CareBridge.Api/wwwroot/css/site.css --no-source-map",
    "sass:watch": "sass --watch src/CareBridge.Api/Styles/site.scss src/CareBridge.Api/wwwroot/css/site.css --no-source-map",
    "test:a11y": "playwright test --config tests/accessibility/playwright.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@playwright/test": "1.47.2",
    "sass": "1.77.8"
  }
}
